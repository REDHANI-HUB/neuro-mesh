# NeuroMesh Environment Variables Configuration Example

# PostgreSQL Database Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=neuromesh
POSTGRES_PASSWORD=neuromesh_secret
POSTGRES_DB=neuromesh_db

# Redis Message Broker Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# EEG Stream Simulator Settings
STREAM_INTERVAL_MS=500
DEMO_MODE=true

# API Gateway & Backend URL
BACKEND_URL=http://backend:8000
